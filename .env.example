# Copy to .env and edit. Every value below is optional for local development.

# ---- General -------------------------------------------------------------
APP_NAME=Reunite
ENV=dev                      # set to "prod" when deployed (disables dev OTP echo and /docs)
SECRET_KEY=change-me-in-production   # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=false            # true only behind exactly one trusted proxy (Render/Railway)

# ---- Database ------------------------------------------------------------
# Zero-setup local default (SQLite, matching done in Python):
DATABASE_URL=sqlite:///./data/app.db
# Supabase / any Postgres with pgvector (matching done in the database):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ---- Auth / OTP ----------------------------------------------------------
MODERATOR_EMAILS=you@example.org     # comma separated; these accounts can review matches
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Email (free: Brevo SMTP, Gmail app password, Resend SMTP) -----------
# Leave SMTP_HOST empty in dev: codes are printed in the server log and returned as dev_otp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Telegram alerts to moderators (optional, free) ----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=

# ---- File storage --------------------------------------------------------
STORAGE_BACKEND=local        # local | supabase
LOCAL_STORAGE_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=reunite-private   # must be a PRIVATE bucket

# ---- Faces ---------------------------------------------------------------
FACE_BACKEND=insightface     # insightface | deepface | mock (mock = demo only, never in prod)
INSIGHTFACE_MODEL=buffalo_l  # use buffalo_sc on 512 MB free hosts
# MATCH_THRESHOLD=0.35       # cosine similarity; defaults per backend. Lower = more candidates for humans to review
MATCH_TOP_K=5

# ---- Image cleanup -------------------------------------------------------
# basic    = safe upscale + contrast + light sharpen, runs locally, never invents detail (default)
# none     = keep only the original
# gfpgan   = local GFPGAN face restoration (needs GFPGAN_MODEL_PATH)
# hf_space = call a public Hugging Face Space. Photos leave your server: get consent/legal advice first.
RESTORE_BACKEND=basic
GFPGAN_MODEL_PATH=
HF_SPACE_ID=sczhou/CodeFormer
HF_SPACE_API_NAME=/inference
# HF_TOKEN=hf_xxx            # read by gradio_client for higher free quota

# ---- Location ------------------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org   # empty disables reverse geocoding
NOMINATIM_CONTACT=you@example.org                   # required by the OSM usage policy

# ---- Text shown to users -------------------------------------------------
NGO_NAME=
NGO_CONTACT=
GRIEVANCE_EMAIL=
